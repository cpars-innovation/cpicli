{
  "$defs": {
    "ops.SecretFinding": {
      "properties": {
        "area": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        },
        "entry": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lastModifiedBy": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "pid": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "area",
        "fingerprint",
        "key",
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "ops.SecretScanResult": {
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ops.SecretFinding"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "scanned": {
          "properties": {
            "artifacts": {
              "type": "integer"
            },
            "binaryParameters": {
              "type": "integer"
            },
            "configurationParameters": {
              "type": "integer"
            },
            "stringParameters": {
              "type": "integer"
            }
          },
          "required": [
            "artifacts",
            "binaryParameters",
            "configurationParameters",
            "stringParameters"
          ],
          "type": "object"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "findings",
        "scanned",
        "source"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/cpars-innovation/cpicli/schemas/secret-scan.json",
  "$ref": "#/$defs/ops.SecretScanResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result field of the --output json envelope (envelope.json) of cpictl secret-scan.",
  "title": "cpictl secret-scan result",
  "x-schemaVersion": 1
}
