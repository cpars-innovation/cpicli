{
  "$defs": {
    "cpi.ChainCertificate": {
      "properties": {
        "fingerprintSha256": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "issuerDN": {
          "type": "string"
        },
        "keySize": {
          "type": "integer"
        },
        "keyType": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "signatureAlgorithm": {
          "type": "string"
        },
        "subjectDN": {
          "type": "string"
        },
        "validNotAfter": {
          "format": "date-time",
          "type": "string"
        },
        "validNotBefore": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "index",
        "validNotAfter",
        "validNotBefore"
      ],
      "type": "object"
    },
    "ops.CertificateChain": {
      "properties": {
        "alias": {
          "type": "string"
        },
        "certificates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/cpi.ChainCertificate"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "certificates"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/cpars-innovation/cpicli/schemas/keystore_chain.json",
  "$ref": "#/$defs/ops.CertificateChain",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result field of the --output json envelope (envelope.json) of cpictl keystore chain.",
  "title": "cpictl keystore chain result",
  "x-schemaVersion": 1
}
