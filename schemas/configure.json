    "cmd.ConfigureStats": {
      "properties": {
        "artifactsConfigured": {
          "type": "integer"
        },
        "artifactsDeployed": {
          "type": "integer"
        },
        "artifactsFailed": {
          "type": "integer"
        },
        "artifactsProcessed": {
          "type": "integer"
        },
        "artifactsUnchanged": {
          "type": "integer"
        },
        "batchRequestsExecuted": {
          "type": "integer"
        },
        "deploymentTasksFailed": {
          "type": "integer"
        },
        "deploymentTasksQueued": {
          "type": "integer"
        },
        "deploymentTasksSuccessful": {
          "type": "integer"
        },
        "individualRequestsUsed": {
          "type": "integer"
        },
        "packagesProcessed": {
          "type": "integer"
        },
        "packagesWithErrors": {
          "type": "integer"
        },
        "parametersFailed": {
          "type": "integer"
        },
        "parametersUnchanged": {
          "type": "integer"
        },
        "parametersUpdated": {
          "type": "integer"
        }
      },
      "required": [
        "artifactsConfigured",
        "artifactsDeployed",
        "artifactsFailed",
        "artifactsProcessed",
        "artifactsUnchanged",
        "batchRequestsExecuted",
        "deploymentTasksFailed",
        "deploymentTasksQueued",
        "deploymentTasksSuccessful",
        "individualRequestsUsed",
        "packagesProcessed",
        "packagesWithErrors",
        "parametersFailed",
        "parametersUnchanged",
        "parametersUpdated"
