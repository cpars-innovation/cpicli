              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "summary"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/cpars-innovation/cpicli/schemas/drift.json",
  "$ref": "#/$defs/ops.DriftResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result field of the --output json envelope (envelope.json) of cpictl drift.",
  "title": "cpictl drift result",
  "x-schemaVersion": 1
}
