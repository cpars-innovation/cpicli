{
  "$defs": {
    "ops.DriftItem": {
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "designtimeVersion": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "localVersion": {
          "type": "string"
        },
        "packageId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "runtimeOutdated": {
          "type": "boolean"
        },
        "runtimeVersion": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
