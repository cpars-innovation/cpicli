{
  "$defs": {
    "ops.CertificateInfo": {
      "properties": {
        "alias": {
          "type": "string"
        },
        "fingerprintSha256": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "notAfter": {
          "format": "date-time",
          "type": "string"
        },
        "notBefore": {
          "format": "date-time",
          "type": "string"
        },
        "pem": {
          "type": "string"
        },
        "serialNumber": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "alias",
        "fingerprintSha256",
        "issuer",
        "notAfter",
        "notBefore",
        "serialNumber",
        "subject"
      ],
      "type": "object"
    },
    "ops.ChainUploadResult": {
      "properties": {
        "alias": {
          "type": "string"
        },
        "certificates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ops.CertificateInfo"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alias",
        "certificates"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/cpars-innovation/cpicli/schemas/keystore_upload-chain.json",
  "$ref": "#/$defs/ops.ChainUploadResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result field of the --output json envelope (envelope.json) of cpictl keystore upload-chain.",
  "title": "cpictl keystore upload-chain result",
  "x-schemaVersion": 1
}
