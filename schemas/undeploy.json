        "designtimeVersion": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "packageId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "runtimeLocation": {
          "type": "string"
        },
        "runtimeVersion": {
          "type": "string"
        },
        "skipped": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "versioning": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/cpars-innovation/cpicli/schemas/undeploy.json",
  "$ref": "#/$defs/cmd.artifactResults",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result field of the --output json envelope (envelope.json) of cpictl undeploy.",
  "title": "cpictl undeploy result",
  "x-schemaVersion": 1
}
