{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v \"${CPICTL_BIN:-cpictl}\" >/dev/null 2>&1 || exit 0; \"${CPICTL_BIN:-cpictl}\" script-doc --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
