{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpars-innovation/cpicli/blob/main/docs/test-case.schema.json",
  "title": "cpictl test case",
  "description": "A test case of a deployed integration flow: .cpi/tests/<FlowId>/<case>.yaml, run with cpictl test run or the MCP tool run_tests. See docs/testing.md (Test runs).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "flow": {
      "title": "Flow",
      "type": "string",
      "description": "Integration flow ID; default the folder name.",
      "examples": [
        "Orders_In"
      ]
    },
    "description": {
      "title": "Description",
      "type": "string",
      "description": "What the case checks.",
      "examples": [
        "Routes a standard order to ERP"
      ]
    },
    "tags": {
      "title": "Tags",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags to select cases (--tag, MCP tags).",
      "examples": [
        [
          "smoke"
        ],
        [
          "smoke",
          "orders"
        ]
      ]
    },
    "skip": {
      "title": "Skip reason",
      "type": "string",
      "description": "Skip the case; the reason.",
      "examples": [
        "ERP sandbox is down until 2026-11-01"
      ]
    },
    "order": {
      "title": "Order",
      "type": "integer",
      "description": "Sorts the cases of a flow (lower first, then by file name).",
      "examples": [
        1,
        10
      ]
    },
    "request": {
      "title": "Request",
      "$ref": "#/$defs/request"
    },
    "expect": {
      "title": "Expected outcome",
      "$ref": "#/$defs/expect"
    }
  },
  "$defs": {
    "stringOrList": {
      "description": "A string or a list of strings.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "duration": {
      "description": "A duration such as 60s, 2m or 1m30s, or a number of seconds.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "request": {
      "type": "object",
      "description": "The message to send.",
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "HTTP method",
          "type": "string",
          "enum": [
            "POST",
            "PUT",
            "PATCH",
            "GET",
            "DELETE",
            "post",
            "put",
            "patch",
            "get",
            "delete"
          ],
          "description": "HTTP method, default POST.",
          "examples": [
            "POST",
            "GET"
          ]
        },
        "content_type": {
          "title": "Content type",
          "type": "string",
          "description": "Content-Type of the body.",
          "examples": [
            "application/xml",
            "application/json"
          ]
        },
        "headers": {
          "title": "Headers",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional HTTP headers (not Authorization, Cookie, X-CSRF-Token, Host, Content-Length).",
          "examples": [
            {
              "X-Test-Run": "smoke",
              "SAP_ApplicationID": "4711"
            }
          ]
        },
        "body": {
          "title": "Body",
          "type": "string",
          "description": "Message body (text).",
          "examples": [
            "<Order><OrderNo>4711</OrderNo></Order>"
          ]
        },
        "body_file": {
          "title": "Body file",
          "type": "string",
          "description": "File with the body, relative to the case file.",
          "examples": [
            "order.xml",
            "payloads/order-4711.json"
          ]
        },
        "url": {
          "title": "Endpoint URL",
          "type": "string",
          "description": "Endpoint URL (or a URL below it); only when the flow has several endpoints.",
          "examples": [
            "https://my-tenant.it-cpi.cfapps.eu10.hana.ondemand.com/http/orders"
          ]
        },
        "endpoint": {
          "title": "Endpoint URL (old name)",
          "type": "string",
          "description": "Older name of url (accepted).",
          "examples": [
            "https://my-tenant.it-cpi.cfapps.eu10.hana.ondemand.com/http/orders"
          ]
        },
        "path": {
          "title": "Sub-path",
          "type": "string",
          "description": "Sub-path and query below the flow's endpoint, for senders that route on the path.",
          "examples": [
            "/v2/orders?mode=test"
          ]
        },
        "process_direct_address": {
          "title": "ProcessDirect address",
          "type": "string",
          "pattern": "^/",
          "description": "ProcessDirect address: the message goes through the test harness flow.",
          "examples": [
            "/orders/route"
          ]
        },
        "idoc": {
          "title": "IDoc XML",
          "type": "string",
          "description": "IDoc XML for the flow's IDoc sender (with EDI_DC40 control record).",
          "examples": [
            "<ORDERS05><IDOC BEGIN=\"1\"><EDI_DC40 SEGMENT=\"1\">...</EDI_DC40></IDOC></ORDERS05>"
          ]
        },
        "idoc_file": {
          "title": "IDoc file",
          "type": "string",
          "description": "File with the IDoc XML, relative to the case file.",
          "examples": [
            "orders05.xml"
          ]
        },
        "odata": {
          "title": "OData request",
          "type": "object",
          "description": "OData V2 request to the flow's OData sender.",
          "additionalProperties": false,
          "properties": {
            "method": {
              "title": "OData method",
              "type": "string",
              "description": "GET (default), POST, PUT, PATCH or DELETE.",
              "examples": [
                "GET",
                "POST"
              ]
            },
            "entity_set": {
              "title": "Entity set",
              "type": "string",
              "description": "Entity set, or $metadata; empty: the service document.",
              "examples": [
                "Orders",
                "$metadata"
              ]
            },
            "key": {
              "title": "Entity key",
              "type": "string",
              "description": "Entity key as written in the parentheses, e.g. '4711'.",
              "examples": [
                "'4711'",
                "OrderID='4711',Item=10"
              ]
            },
            "query": {
              "title": "Query",
              "type": "string",
              "description": "Query string, e.g. $filter=Status eq 'OPEN'&$top=10.",
              "examples": [
                "$filter=Status eq 'OPEN'&$top=10"
              ]
            }
          },
          "examples": [
            {
              "method": "GET",
              "entity_set": "Orders",
              "key": "'4711'"
            }
          ]
        },
        "wait": {
          "title": "Wait",
          "$ref": "#/$defs/duration",
          "description": "How long to wait for the message processing log, default 60s.",
          "examples": [
            "60s",
            "2m"
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "description": "The expected outcome; every expectation that is set must hold. Without http_status and error_contains the HTTP status must be 2xx, unless message_status expects a failure (FAILED, ESCALATED, ...).",
      "additionalProperties": false,
      "properties": {
        "http_status": {
          "title": "HTTP status",
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "HTTP status of the endpoint's answer.",
          "examples": [
            200,
            500
          ]
        },
        "message_status": {
          "title": "Message status",
          "type": "string",
          "description": "Final status of the message: COMPLETED, FAILED, ESCALATED, ... (empty: not checked).",
          "examples": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "response_contains": {
          "title": "Response contains",
          "$ref": "#/$defs/stringOrList",
          "description": "Texts the response contains.",
          "examples": [
            "<Status>OK</Status>",
            [
              "4711",
              "accepted"
            ]
          ]
        },
        "response_not_contains": {
          "title": "Response does not contain",
          "$ref": "#/$defs/stringOrList",
          "description": "Texts the response does not contain.",
          "examples": [
            "error"
          ]
        },
        "response_xpath": {
          "title": "Response XPath",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Path (/a/b, //name, [@attr='v'], /@attr, /text()) -> expected text of the first match.",
          "examples": [
            {
              "/Order/Status": "ACCEPTED"
            }
          ]
        },
        "response_json": {
          "title": "Response JSON",
          "type": "object",
          "description": "Dotted path (a.b.0.c) -> expected value (numbers by value, objects and arrays as JSON).",
          "examples": [
            {
              "order.status": "ACCEPTED",
              "items.0.qty": 2
            }
          ]
        },
        "error_contains": {
          "title": "Error contains",
          "$ref": "#/$defs/stringOrList",
          "description": "Texts expected in the error: the log's error text or the response of a failed call.",
          "examples": [
            "HTTP 504",
            [
              "Connection refused",
              "erp"
            ]
          ]
        },
        "custom_headers": {
          "title": "Custom header properties",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Custom header properties expected in the message processing log.",
          "examples": [
            {
              "OrderNo": "4711"
            }
          ]
        },
        "steps_include": {
          "title": "Steps include",
          "$ref": "#/$defs/stringOrList",
          "description": "Step names or model step IDs that appear in the message's steps.",
          "examples": [
            "Map Order",
            [
              "CallActivity_3",
              "Send to ERP"
            ]
          ]
        },
        "max_duration": {
          "title": "Maximum duration",
          "$ref": "#/$defs/duration",
          "description": "Longest processing time (the message log, else the HTTP call).",
          "examples": [
            "5s",
            2
          ]
        },
        "stub_calls": {
          "title": "Receiver stub calls",
          "type": "array",
          "description": "Requests the receiver stub (CPICTL_Test_Stub) must have recorded since the case started. Cases with stub_calls run alone.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rule": {
                "title": "Stub rule",
                "type": "string",
                "description": "The path segment after /cpictl/stub/.",
                "examples": [
                  "erp"
                ]
              },
              "method": {
                "title": "Method",
                "type": "string",
                "description": "HTTP method (any case).",
                "examples": [
                  "POST"
                ]
              },
              "path_contains": {
                "title": "Path contains",
                "type": "string",
                "description": "Text in the path below /cpictl/stub/.",
                "examples": [
                  "orders"
                ]
              },
              "body_contains": {
                "title": "Body contains",
                "$ref": "#/$defs/stringOrList",
                "description": "Texts in the body.",
                "examples": [
                  "<OrderNo>4711</OrderNo>"
                ]
              },
              "header": {
                "title": "Headers",
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Headers (name in any case) with these values.",
                "examples": [
                  {
                    "Content-Type": "application/xml"
                  }
                ]
              },
              "count": {
                "title": "Count",
                "type": "integer",
                "minimum": 0,
                "description": "Number of matching calls, default 1 (0: none).",
                "examples": [
                  1,
                  0
                ]
              }
            }
          },
          "examples": [
            [
              {
                "rule": "erp",
                "method": "POST",
                "body_contains": [
                  "4711"
                ]
              }
            ]
          ]
        }
      }
    }
  }
}
