{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cpi-dev": {
      "type": "local",
      "command": ["cpictl", "mcp", "--root", ".", "--profile", "dev", "--mode", "develop", "--toolset", "build,test"],
      "enabled": true,
      "timeout": 15000
    },
    "cpi-qa": {
      "type": "local",
      "command": ["cpictl", "mcp", "--root", ".", "--profile", "qa", "--read-only", "--toolset", "inspect,monitor"],
      "enabled": true,
      "timeout": 15000
    }
  }
}
