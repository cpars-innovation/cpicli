# Allowlisting gitignore template for GO projects prevents us
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore

# Ignore everything
*
# But descend into directories
!*/

# Allow these files...
!/.gitignore

!*.go
!go.sum
!go.mod

!*.md
!LICENSE
!NOTICE
!.gitattributes
!*.golden

# Allow also these directories...
!.github/**
!build/**
!docs/**
!licenses/**
!test/**
!scripts/**
!plugin/**
!/.claude-plugin/**


!Makefile

# Test fixtures
!**/testdata/**

# Landscape fixtures embedded by the mock tenant (go:embed)
!internal/cpitest/landscapes/**

# Component catalogue of the mock tenant's runtime profile (go:embed)
!internal/cpitest/components.json

# Test tooling artifacts embedded in the binary (go:embed)
!pkg/testtools/artifacts/**
!pkg/scripttest/template/**
